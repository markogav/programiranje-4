#include <bits/stdc++.h>
using namespace std;
struct Point {
    long long x, y;
    bool operator==(const Point& t) const {
        return x == t.x && y == t.y;
    }
};
int orientation(Point a, Point b, Point c) {
    long long v =
        a.x * (b.y - c.y) +
        b.x * (c.y - a.y) +
        c.x * (a.y - b.y);

    if (v < 0) return -1;
    if (v > 0) return 1;
    return 0;
}
long long distSq(Point a, Point b) {
    return (a.x - b.x) * (a.x - b.x) +
           (a.y - b.y) * (a.y - b.y);
}
vector<Point> findConvexHull(vector<Point>& points) {
    int n = points.size();
    if (n < 3) return {};
    Point p0 = *min_element(points.begin(), points.end(),
        [](Point a, Point b) {
            return make_pair(a.x, a.y) < make_pair(b.x, b.y);
        });
    sort(points.begin(), points.end(),
        [&p0](Point a, Point b) {

            int o = orientation(p0, a, b);
            if (o == 0)
                return distSq(p0, a) < distSq(p0, b);

            return o < 0;
        });
    vector<Point> st;
    for (int i = 0; i < n; i++) {
        while (st.size() > 1 &&
               orientation(st[st.size()-2], st.back(), points[i]) >= 0) {
            st.pop_back();
        }
        st.push_back(points[i]);
    }
    if (st.size() < 3) return {};
    return st;
}
int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
    int n;
    cin >> n;
    vector<Point> points(n);

    for (int i = 0; i < n; i++) {
        cin >> points[i].x >> points[i].y;
    }
    cout<<endl;
    vector<Point> hull = findConvexHull(points);
    if (hull.empty()) {
        cout << -1 << "\n";
    } else {
        for (auto p : hull) {
            cout << p.x << " " << p.y << "\n";
        }
    }
    return 0;
}
